# 실제 값은 .env 에 넣는다 (.gitignore 대상). 어떤 키도 커밋하지 않는다.
# 쓰는 벤더 것만 채우면 된다. 나머지는 지우거나 그대로 둬도 된다(프록시가 그 모델을 안 부르면 그만).

# 주력. 단가·모델은 pricing.yaml / litellm_config.yaml 참고
GEMINI_API_KEY=AIza...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=            # 클라우드 비교군을 늘릴 때만
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 지출 상한(USD). litellm 의 max_budget 은 DB 없이는 안 먹는다 -> harness 가 직접 막는다.
# **프로젝트 전체 누적**이고 토큰 + 크레딧 + 스텝을 다 더한 값이다(harness/ledger.py).
# 프록시를 재시작해도 이어서 센다. 현황: python -m harness.ledger
AICRAWL_MAX_USD=8
# 도구별 단위 상한(크레딧/스텝)은 pricing.yaml 의 services.<도구>.max_units 에 있다.

# LiteLLM proxy
LITELLM_MASTER_KEY=sk-local-aicrawl
LITELLM_JSONL=./logs/litellm.jsonl

# 어댑터는 이 두 값만 보고 프록시를 탄다 (도구가 직접 벤더 API 를 치면 계측이 새어나간다)
OPENAI_API_BASE=http://127.0.0.1:4000
OPENAI_API_KEY_PROXY=sk-local-aicrawl

# --------------------------------------------------- 비토큰 과금 도구
# Firecrawl. **기본은 셀프호스팅**이다 - 클라우드는 자기 서버가 URL 을 가져가므로
# 우리 리플레이 서버(127.0.0.1)에 닿지 못한다(adapters/firecrawl_runner.py 도크 참고).
FIRECRAWL_API_URL=http://127.0.0.1:3002
# FIRECRAWL_API_KEY=fc-...   # 클라우드를 재려면. --live 와 같이 써야 의미가 있다
# SKYVERN_API_KEY=
